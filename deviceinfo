############################
# Basic device information
############################

deviceinfo_name="OnePlus 8"
deviceinfo_manufacturer="OnePlus"
deviceinfo_codename="instantnoodle"
deviceinfo_arch="aarch64"
deviceinfo_halium_version="10"
# Valid values: focal, 24.04-1.x, 24.04-2.x ("noble" is rejected by prepare-fake-ota.sh)
deviceinfo_ubuntu_touch_release="24.04-2.x"

##########
# Kernel
##########

deviceinfo_kernel_source="https://github.com/scotthowson/Ubuntu_ElementalX_OnePlus8"
deviceinfo_kernel_source_branch="Halium-10"
deviceinfo_kernel_defconfig="halium-instantnoodle_ubuntu_defconfig"
# Note: CONFIG_CMDLINE in the kernel is ignored (the bootloader supplies the cmdline), so
# everything the kernel needs has to be here. Do NOT add systemd.unified_cgroup_hierarchy=0:
# Ubuntu Touch 24.04 runs on cgroup v2 and the build that boots does not have it.
deviceinfo_kernel_cmdline="androidboot.hardware=qcom androidboot.console=ttyMSM0 androidboot.memcg=1 lpm_levels.sleep_disabled=1 video=vfb:640x400,bpp=32,memsize=3072000 msm_rtb.filter=0x237 service_locator.enable=1 androidboot.usbcontroller=a600000.dwc3 androidboot.selinux=permissive swiotlb=2048 loop.max_part=7 cgroup.memory=nokmem,nosocket reboot=panic_warm selinux=0 apparmor=1 security=apparmor buildvariant=user systempart=/dev/mapper/system_a console=tty0"
deviceinfo_kernel_clang_compile="true"
deviceinfo_kernel_llvm_compile="false"
deviceinfo_kernel_use_lld="false"
deviceinfo_kernel_use_dtc_ext="true"
deviceinfo_kernel_image_name="Image"

##############
# Boot image
##############

deviceinfo_bootimg_header_version="2"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_offset_dtb="0x01f00000"
deviceinfo_bootimg_os_version="10"
deviceinfo_bootimg_os_patch_level="2020-10"
deviceinfo_bootimg_partition_size="100663296"
deviceinfo_bootimg_append_vbmeta="true"
deviceinfo_bootimg_qcdt="false"

##########
# DTB(O)
##########

# Device trees are built from the kernel source (paths relative to arch/arm64/boot/dts/ in the
# kernel build directory). The three kona base trees are concatenated into the boot image's DTB
# section; the bootloader picks the matching one by msm-id/board-id. The dtbo image carries the
# OnePlus 8 (instantnoodle) overlays for the T0, EVT1 and DVT hardware revisions.
deviceinfo_dtb="vendor/qcom/kona.dtb vendor/qcom/kona-v2.dtb vendor/qcom/kona-v2.1.dtb"
deviceinfo_dtbo="vendor/qcom/instantnoodle-overlay-t0.dtbo vendor/qcom/instantnoodle-overlay-evt1.dtbo vendor/qcom/instantnoodle-overlay-dvt.dtbo"
# Previous prebuilt files, kept until a source-built boot is confirmed on the device:
# deviceinfo_bootimg_prebuilt_dtb="oneplus-instantnoodle-instantnoodle.dtb"
# deviceinfo_prebuilt_dtbo="oneplus-instantnoodle-dtbo.img"

###########
# Ramdisk
###########

deviceinfo_ramdisk_compression="gzip"
deviceinfo_rootfs_image_sector_size="4096"

###########
# Recovery
###########

# Recovery is built from the prebuilt ./ramdisk-recovery.img (known working) with
# ./ramdisk-recovery-overlay/ applied on top.
deviceinfo_has_recovery_partition="true"
deviceinfo_recovery_partition_size="100663296"
# Alternative used by current UBports ports: drop ramdisk-recovery.img and enable
# deviceinfo_use_unified_recovery="true"
# deviceinfo_unified_recovery_ui_density="xxhdpi"

#################
# Miscellaneous
################

# Overlay store (device files applied from a hidden store at boot). Left off: the build that
# boots uses the normal layout. Try "true" only as a separate, deliberate test.
# deviceinfo_use_overlaystore="true"
# Maximum size of the rootfs image written to system_a
