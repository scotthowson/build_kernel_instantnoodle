[Unit]
Description=Load the in-kernel QCA WLAN driver (write ON to /dev/wlan)
# qcacld-3.0 is built into the kernel (CONFIG_QCA_CLD_WLAN=y). Unlike the vendor module, the
# built-in driver only creates /dev/wlan at boot and stays dormant until userspace writes "ON"
# to it (the Android WiFi HAL does this on stock). Firmware comes from /vendor through the
# container's ueventd, so wait for the container to finish booting first. cnss2 waits for its
# own cold-boot calibration, so the timing after that is safe. The write blocks until the
# driver has probed, hence the long timeout.
After=lxc-android-config.service
Wants=lxc-android-config.service
ConditionPathExists=/dev/wlan

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do [ "$(/usr/bin/getprop sys.boot_completed 2>/dev/null)" = 1 ] && exit 0; sleep 1; done; echo "sys.boot_completed not seen, trying anyway"; exit 0'
ExecStart=/bin/sh -c 'up() { ls /sys/class/net | grep -q "^wl"; }; for i in 1 2 3 4 5; do up && { echo "wlan interface is up"; exit 0; }; echo ON > /dev/wlan 2>/dev/null; sleep 3; done; up || { echo "wlan interface did not appear"; exit 1; }'

[Install]
WantedBy=multi-user.target
